NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5178
MONGO_URI=mongodb://127.0.0.1:27017/freelancehub
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
SKIP_EMAIL_VERIFY=true
