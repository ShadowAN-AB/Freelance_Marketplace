NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5178
MONGO_URI=mongodb://127.0.0.1:27017/freelancehub
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
SKIP_EMAIL_VERIFY=true
# Optional production integrations (leave unset for the simulated demo)
# SMTP_URL=smtp://localhost:1025
# MAIL_FROM=FreelanceHub <noreply@freelancehub.dev>
# REDIS_URL=redis://127.0.0.1:6379
# AWS_S3_BUCKET=
# AWS_REGION=ap-south-1
# AWS_S3_PUBLIC_URL=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Optional LLM matching (OpenAI-compatible). Unset = skill overlap + written rationale.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# Split compose uses SERVICE=auth|marketplace|realtime and a gateway on :5001
# AUTH_URL=http://127.0.0.1:5002
# MARKETPLACE_URL=http://127.0.0.1:5003
# REALTIME_URL=http://127.0.0.1:5004
